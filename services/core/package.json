{
  "name": "@dizaster/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de Dizaster: monolito modular (API + workers).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "node --import ./dist/telemetry.js dist/server.js",
    "worker": "node --import ./dist/telemetry.js dist/worker.js",
    "migrate": "node dist/migrate-cli.js",
    "geo:import": "node dist/geo-import-cli.js",
    "geo:import:dev": "tsx src/geo-import-cli.ts",
    "cost:report": "node dist/cost-report-cli.js",
    "quality:report": "node dist/quality-report-cli.js",
    "grant-role": "node dist/grant-role-cli.js"
  },
  "dependencies": {
    "@dizaster/contracts": "workspace:*",
    "@dizaster/geo-kit": "workspace:*",
    "@fastify/otel": "^0.21.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "geo-tz": "8.1.9",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
