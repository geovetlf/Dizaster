# Copiar a .env para desarrollo local. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://dizaster:dizaster@localhost:5432/dizaster_dev
# Secreto para firmar sesiones en desarrollo. En producción: gestor de secretos y claves asimétricas.
AUTH_JWT_SECRET=change-me-dev-only-32-characters-min
DEV_AUTH_ENABLED=true
# Mapa: estilo MapLibre. Desarrollo usa el estilo de demostración público de MapLibre (baja resolución).
MAP_PROVIDER_ID=maplibre-demo
MAP_STYLE_URL_LIGHT=https://demotiles.maplibre.org/style.json
MAP_STYLE_URL_DARK=https://demotiles.maplibre.org/style.json
MAP_ATTRIBUTION=© OpenStreetMap contributors · MapLibre
REPORTS_PER_HOUR_LIMIT=10
# Versión mínima de la app por plataforma (ADR 0164): vacío = sin mínimo. Por debajo, 426 al enviar reportes/posts.
MIN_APP_VERSION_ANDROID=
MIN_APP_VERSION_IOS=
# Enlaces a la ficha de la tienda (BLOQUEADO hasta tener cuentas de desarrollador).
STORE_URL_ANDROID=
STORE_URL_IOS=
PRESENCE_RETENTION_DAYS=30
# Media: en desarrollo, disco local servido por la propia API. En producción, S3 compatible (p. ej. R2, sin egreso).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Dirección con la que el emulador/dispositivo alcanza esta API (Android emulador: http://10.0.2.2:8080).
PUBLIC_API_URL=http://localhost:8080
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=dizaster-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=https://media.<dominio>
MEDIA_UPLOADS_PER_HOUR_LIMIT=30
# Tope diario de MB subidos por cuenta (ADR 0072); NEW recibe la mitad y LOW un cuarto.
MEDIA_DAILY_UPLOAD_MB=300
# MFA TOTP para moderación y administración (ADR 0090): auto = exigida solo en producción.
STAFF_MFA_REQUIRED=auto
# Días que se guarda el crudo comprimido de cada fuente (ADR 0075); 0 = no se guarda.
SOURCE_RAW_RETENTION_DAYS=30
MEDIA_ORIGINAL_RETENTION_DAYS=30
# Alertas push directas a APNs y FCM (gratis). "log" solo escribe en el log; producción exige "live".
PUSH_DRIVER=log
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=   # contenido del .p8 (PEM) o en base64
# APNS_BUNDLE_ID=app.dizaster.mobile
# FCM_SERVICE_ACCOUNT_JSON=   # JSON de la cuenta de servicio de Firebase, o en base64
# Cifrado por columna de la ubicación precisa (ADR 0048). Obligatorio en producción. Generar con:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Para rotar, poner la nueva primero y mantener la anterior 30 días (retención de la presencia).
# FIELD_KEYS=k1:...
# Límite general de peticiones por minuto (ADR 0047).
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_WRITES_PER_MINUTE=60
# TRUST_PROXY=false
# Trazas OpenTelemetry (ADR 0052). Sin endpoint no se envía nada. Cualquier colector OTLP/HTTP sirve
# (Grafana Alloy/Tempo autoalojado o capa gratuita de Grafana Cloud).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic ...
# OTEL_SERVICE_NAME=dizaster-core
# OTEL_SAMPLE_RATIO=0.1
# Días que un evento RESOLVED sigue en el mapa antes de archivarse (ADR 0061, D-ARCHIVE).
# EVENT_ARCHIVE_AFTER_DAYS=7

# Conectores (ADR 0064). Modo costo cero por defecto: ningún proveedor de pago arranca.
# COST_MODE=zero
# AI_PROVIDER=none          # none | fixture (respuestas fijas, solo desarrollo)
# AI_ROUTES=               # rutas por capacidad del AI ROUTER, p. ej. CLASSIFY_INCIDENT=fixture;*=none (vacío = AI_PROVIDER)
# AI_TIMEOUT_MS=8000
# TRANSLATION_PROVIDER=none
# SMS_PROVIDER=none         # none | log (solo desarrollo)
# STT_PROVIDER=none
# TTS_PROVIDER=none

# Claves de fuentes (ADR 0067): nunca en data/. La URL de la fuente las referencia como {secret:SOURCE_KEY_…}.
# SOURCE_KEY_FIRMS=        # MAP_KEY gratuita de NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# Push firmado de una fuente (ADR 0128): secreto HMAC compartido con la fuente; además config.push=true en sources.json.
# SOURCE_PUSH_SECRET_<CLAVE>=   # p. ej. SOURCE_PUSH_SECRET_GDACS
# Retención de datos operativos (ADR 0165): historial de avisos y eventos de dominio ya procesados.
NOTIFICATION_RETENTION_DAYS=90
OUTBOX_RETENTION_DAYS=14
# Inicio de sesión real (ADR 0170). Vacío = apagado. BLOQUEADO hasta tener las cuentas de Apple/Google del propietario.
AUTH_APPLE_AUDIENCES=
AUTH_GOOGLE_AUDIENCES=
# Correo con código: none (apagado) | log (solo desarrollo). El proveedor real lo elige el propietario.
EMAIL_PROVIDER=none
