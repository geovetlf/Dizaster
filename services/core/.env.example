# Copiar a .env para desarrollo local. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://dizaster:dizaster@localhost:5432/dizaster_dev
# Secreto para firmar sesiones en desarrollo. En producción: gestor de secretos y claves asimétricas.
AUTH_JWT_SECRET=change-me-dev-only-32-characters-min
DEV_AUTH_ENABLED=true
# Mapa: estilo MapLibre. Desarrollo usa el estilo de demostración público de MapLibre (baja resolución).
MAP_PROVIDER_ID=maplibre-demo
MAP_STYLE_URL_LIGHT=https://demotiles.maplibre.org/style.json
MAP_STYLE_URL_DARK=https://demotiles.maplibre.org/style.json
MAP_ATTRIBUTION=© OpenStreetMap contributors · MapLibre
REPORTS_PER_HOUR_LIMIT=10
PRESENCE_RETENTION_DAYS=30
