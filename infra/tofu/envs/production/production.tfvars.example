# Copiar a production.tfvars (ignorado por git) y completar. Todos los valores son decisiones del propietario.
project_id        = "<id del proyecto production>"
region            = "<región>"
github_repository = "<owner>/<repo>"
image             = "<región>-docker.pkg.dev/<proyecto>/dizaster/core@sha256:<digest>"
api_min_instances = <número: decisión de costo>
api_max_instances = <número: decisión de costo>
worker_instances  = <número: decisión de costo>
public_api_url    = "https://<dominio de la API>"
storage = {
  endpoint        = "<endpoint S3-compatible>"
  bucket          = "<bucket de media>"
  public_base_url = "<URL pública de media>"
}
backup = {
  project_id     = "<proyecto de respaldos, idealmente distinto>"
  location       = "<ubicación>"
  bucket_name    = "<nombre único del bucket>"
  retention_days = <días: decisión del propietario>
}
alert_email = "<correo de guardia>"
billing = {
  account        = "<cuenta de facturación>"
  currency_code  = "<moneda de la cuenta>"
  monthly_amount = <presupuesto mensual: decisión del propietario>
}
delivery_state_bucket = "<bucket creado por infra/tofu/bootstrap>"
# Base de datos (D-23): una de las tres. Tamaños y respaldos son decisiones de costo del propietario.
database = {
  mode = "<cloudsql | vm | external>"
  # cloudsql = { tier = "<tipo>", edition = "ENTERPRISE", disk_size_gb = <GB>, availability_type = "ZONAL",
  #              backup_start_time = "<HH:MM UTC>", retained_backups = <n>, point_in_time_recovery = <true|false> }
  # vm = { zone = "<zona>", machine_type = "<tipo>", disk_size_gb = <GB>, subnet_cidr = "<rango privado>",
  #        image = "<región>-docker.pkg.dev/<proyecto>/dizaster/db@sha256:<digest>" }
}
# Opcional: bucket de media en GCS (si no, R2 u otro S3 en `storage`).
# media_bucket = { location = "<ubicación>", bucket_name = "<igual a storage.bucket>", public_read = <true|false> }
