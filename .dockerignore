**/node_modules
**/dist
**/dist-check
.git
.github
**/.env
**/.env.*
!**/.env.example
**/.terraform
**/*.tfstate*
**/*.tfvars
delivery-audit.jsonl
sbom.cdx.json
*.oci.tar
*.manifest.json
docs
